# ============================================================================
#  Telegram Community Bot - configuration
#  Copy to `.env` (same folder as the project) and fill in real values.
#    cp .env.example .env
#  NEVER commit `.env` - it is git-ignored on purpose.
# ============================================================================

# ---------------------------------------------------------------------------
# Telegram credentials (all three are required)
#   API_ID / API_HASH : https://my.telegram.org  ->  API development tools
#   BOT_TOKEN         : https://t.me/BotFather  ->  /newbot
# ---------------------------------------------------------------------------
API_ID=
API_HASH=
BOT_TOKEN=

# Numeric Telegram user IDs that always have full owner access (comma separated).
# Find your own id by sending /id to the bot, or via @userinfobot.
OWNER_IDS=

# Optional: channel/group id that receives moderation & error logs (e.g. -1001234567890)
LOG_CHAT_ID=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=production          # development | production
TIMEZONE=Asia/Tehran            # any IANA zone, e.g. Europe/Berlin
DEFAULT_LANGUAGE=fa             # fa | en
DATA_DIR=data
SESSION_DIR=sessions
LOG_DIR=logs
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                  # true = one JSON object per line (for log collectors)
LOG_ROTATE_MB=5
LOG_BACKUP_COUNT=5

# ---------------------------------------------------------------------------
# Feature switches
# ---------------------------------------------------------------------------
FEATURE_TICKETS=true            # support ticket system
FEATURE_MODERATION=true         # /warn /mute /ban ... inside groups
FEATURE_ANTISPAM=true           # flood / banned-word / link protection
FEATURE_BROADCAST=true          # owner broadcast to opted-in users

# ---------------------------------------------------------------------------
# Anti-spam (applies to groups where the bot is admin with "Delete messages")
# ---------------------------------------------------------------------------
ANTISPAM_FLOOD_MESSAGES=8       # messages allowed ...
ANTISPAM_FLOOD_WINDOW=10        # ... per this many seconds
ANTISPAM_ACTION=warn            # delete | warn | mute
ANTISPAM_MUTE_MINUTES=60
ANTISPAM_WARN_LIMIT=3           # warns before automatic mute
ANTISPAM_BAN_LIMIT=5            # warns before automatic ban
ANTISPAM_BLOCK_LINKS=false      # delete messages that contain links (unless allowed)
# Comma separated whitelist of always-allowed domains.
ANTISPAM_ALLOWED_DOMAINS=
# Comma separated banned words (plain text or regex).
ANTISPAM_BANNED_WORDS=
ANTISPAM_NEW_USER_SECONDS=0     # restrict link sending for the first N seconds of membership

# ---------------------------------------------------------------------------
# Limits & cooldowns
# ---------------------------------------------------------------------------
RATELIMIT_COMMANDS=20           # commands per window per user
RATELIMIT_WINDOW=60
TICKET_COOLDOWN_SECONDS=300
TICKET_MAX_OPEN=3
BROADCAST_DELAY=0.06            # seconds between messages (Telegram safe pacing)
BROADCAST_CONCURRENCY=4
